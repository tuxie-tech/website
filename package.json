{
  "name": "website",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "11ty:dev": "npx @11ty/eleventy --serve",
    "clean": "rm -rf ./dist",
    "tw:build": "npx @tailwindcss/cli -i ./src/assets/css/style.css -o ./dist/assets/css/main.css --minify",
    "tw:watch": "npx @tailwindcss/cli -i ./src/assets/css/style.css -o ./dist/assets/css/main.css --watch",
    "dev": "npm run clean && concurrently \"npm:tw:watch\" \"npm:11ty:dev\"",
    "build": "npm run clean && npm run tw:build && npx @11ty/eleventy --pathprefix ${PATH_PREFIX:-/}"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tuxie-tech/website.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/tuxie-tech/website/issues"
  },
  "homepage": "https://github.com/tuxie-tech/website#readme",
  "dependencies": {
    "@11ty/eleventy": "^3.1.6"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "concurrently": "^10.0.3",
    "tailwindcss": "^4.3.0"
  }
}
