{%- set currentUrl = page.url or "/" -%}
{%- set trimmedPath = currentUrl -%}
{%- if trimmedPath.startsWith("/") -%}
	{%- set trimmedPath = trimmedPath.slice(1) -%}
{%- endif -%}
{%- if trimmedPath.endsWith("/") -%}
	{%- set trimmedPath = trimmedPath.slice(0, -1) -%}
{%- endif -%}
{%- set pathSegments = [] -%}
{%- if trimmedPath -%}
	{%- set pathSegments = trimmedPath.split("/") -%}
{%- endif -%}
{%- set homeLabel = "Home" -%}
{%- for candidate in collections.pages -%}
	{%- if candidate.url == "/" and candidate.data.title -%}
		{%- set homeLabel = candidate.data.title -%}
	{%- endif -%}
{%- endfor -%}

{%- set parentHref = "/" -%}
{%- set parentLabel = homeLabel -%}
{%- if pathSegments.length > 1 -%}
	{%- set parentHref = "/" + pathSegments.slice(0, pathSegments.length - 1).join("/") + "/" -%}
	{%- set parentLabel = pathSegments[pathSegments.length - 2] | replace("-", " ") | title -%}
	{%- for candidate in collections.pages -%}
		{%- if candidate.url == parentHref and candidate.data.title -%}
			{%- set parentLabel = candidate.data.title -%}
		{%- endif -%}
	{%- endfor -%}
{%- endif -%}

<nav aria-label="Breadcrumb" class="text-sm text-gray-600">
	{%- if pathSegments.length > 0 -%}
	<a href="{{ parentHref | url }}" class="crumb-back noline" aria-label="Back to {{ parentLabel }}">&larr; Back to {{ parentLabel }}</a>
	{%- endif -%}
	<ol class="crumbs">
		{%- if pathSegments.length > 0 -%}
		<li><a href="{{ '/' | url }}" class="hover:underline noline">{{ homeLabel }}</a></li>
		{%- for segment in pathSegments -%}
			{%- set crumbHref = "/" + pathSegments.slice(0, loop.index).join("/") + "/" -%}
			{%- set label = segment | replace("-", " ") | title -%}
			{%- for candidate in collections.pages -%}
				{%- if candidate.url == crumbHref and candidate.data.title -%}
					{%- set label = candidate.data.title -%}
				{%- endif -%}
			{%- endfor -%}
			{%- if loop.last -%}
			<li aria-current="page" class="font-semibold">{{ label }}</li>
			{%- else -%}
			<li><a href="{{ crumbHref | url }}" class="hover:underline noline text-secondary">{{ label }}</a></li>
			{%- endif -%}
		{%- endfor -%}
		{%- else -%}
		<li aria-current="page" class="font-semibold text-secondary">{{ homeLabel }}</li>
		{%- endif -%}
	</ol>
</nav>
