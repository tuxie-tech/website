{% macro simple(title, hero='') %}
<div class="h-full w-full p-4 bg-highlight shadow-lg rounded-lg">
    <h3 class="text-xl font-semibold mb-2 text-center">{{ title }}</h3>
    {%- if hero -%}
        <img src="{{ hero }}" class="w-full h-auto mb-2" />
    {%- endif -%}
</div>
{% endmacro %}

{% macro clickable(title, hero='', url='/') %}
<a href="{{ url }}" class="block h-full text-blue-500 hover:text-blue-700">
    {{ simple(title, hero) }}
</a>
{% endmacro %}