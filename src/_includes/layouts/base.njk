<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }} - TuxieTech</title>
    <link rel="stylesheet" href="{{ '/assets/css/main.css' | url }}">
</head>
<body>
    <div class="flex flex-col items-stretch min-h-screen bg-1-3 px-4">
        {%- include "partials/header.njk" -%}
        
        <main class="container mx-auto px-4 p-10 shadow-lg bg-white">
            <article class="">
                {{ content | safe }}
            </article>
        </main>
        <div class="flex-grow">&nbsp;</div>
        <footer class="footer sticky-footer text-gray-400 py-4 px-1 flex">
            <div class="ml-auto">Designed by <a href="https://johnvidler.co.uk/">John Vidler</a></div>
            <div>Built with <a href="https://www.11ty.dev/">Eleventy</a></div>
        </footer>
    </div>
    
</body>
</html>