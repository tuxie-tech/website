<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }} - TuxieTech</title>
    <link rel="stylesheet" href="{{ '/assets/css/main.css' | url }}">
</head>
<body>
    <div class="hero-bg absolute top-0 left-0 w-screen overflow-clip">
        {%- if hero -%}
        {%- else -%}
            <img src="{{ '/assets/img/hero/rib-bit-hero.png' | url }}" class="w-full h-full object-cover">
        {%- endif -%}
    </div>
    <div class="flex flex-col min-h-screen bg-1-3-lesser px-4">
        {%- include "partials/header.njk" -%}

        <div class="flex flex-col xl:flex-row items-start">
            {%- if info -%}
            <div class="xl:w-3/12 p-5 mx-auto container">
                <div class="shadow-lg bg-white mx-auto max-w-96rem p-5">
                    {{ info }}
                </div>
            </div>
            {%- endif -%}
            
            {%- if hero -%}
            <div class="xl:w-3/12 mx-auto">
                <img src="{{ hero }}" class="w-4/5 shadow-alpha" />
            </div>
            {%- endif -%}

            <div class="{{ 'xl:w-6/12' if info }} container mx-auto bg-white xl:mr-0 px-4 p-10">
                <div class="mx-auto max-w-96rem p-5">
                    {{ content | safe }}
                </div>
            </div>
        </div>
        <div class="grow">&nbsp;</div>
        <footer class="footer sticky-footer text-gray-400 py-4 px-1 flex">
            <div class="ml-auto">Designed by <a href="https://johnvidler.co.uk/">John Vidler</a></div>
            <div>Built with <a href="https://www.11ty.dev/">Eleventy</a></div>
        </footer>
    </div>
    
</body>
</html>